{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Flux",
  "scopeName": "source.flux",
  "patterns": [
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#operators" }
  ],
  "repository": {
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.flux",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            { "name": "constant.character.escape.flux", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.raw.flux",
          "begin": "r\"",
          "end": "\""
        },
        {
          "name": "string.quoted.double.flux",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.flux", "match": "\\\\." },
            { "name": "variable.other.interpolation.flux", "match": "\\$[A-Z_][A-Z0-9_]*|\\$\\{[A-Z_][A-Z0-9_]*\\}" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.flux",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.flux",
          "match": "\\b(i64|bool|str|error|void)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flux",
          "match": "\\b(if|elif|else|for|while|match|return|break|continue|await|async|in)\\b"
        },
        {
          "name": "storage.type.flux",
          "match": "\\b(fn|struct|enum|interface|type|view|app|impl)\\b"
        },
        {
          "name": "storage.modifier.flux",
          "match": "\\b(pub|let|var|const|state|derived|import)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.flux",
          "match": "\\b(true|false|none|nil)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.flux",
          "match": "(\\?\\?=|\\?\\?|\\?\\.|\\?\\[|\\?\\.\\.|\\.\\.|>>|->|=>|==|!=|<=|>=|&&|\\|\\||\\+|-|\\*|/|%|<|>|=|!|\\||&|\\?)"
        }
      ]
    }
  }
}
